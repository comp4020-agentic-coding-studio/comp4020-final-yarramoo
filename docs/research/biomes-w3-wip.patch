+            continue;
+        }
+        for y in t..t + GAS_POCKET_ROWS {
+            if g.mat[(y * w + x) as usize] != EMPTY {
+                break;
+            }
+            g.mat[(y * w + x) as usize] = GAS;
+        }
+    }
+}
