{
  "id": "mvp",
  "name": "Kestrel-1 suborbital",
  "countdownSec": 240,
  "holdBudgetSec": 120,
  "roles": ["flight", "propulsion", "ground"],
  "values": {
    "tank_pressure": {
      "role": "propulsion",
      "label": "Propellant tank pressure",
      "unit": "kPa",
      "start": 100,
      "driftPerSec": 0,
      "nominal": [230, 270],
      "limit": [50, 335]
    },
    "bus_voltage": {
      "role": "ground",
      "label": "Pad power bus B",
      "unit": "V",
      "start": 28,
      "driftPerSec": 0,
      "nominal": [27, 29],
      "limit": [24, 31]
    }
  },
  "steps": [
    { "id": "arm_retract", "role": "ground", "label": "Retract crew access arm", "after": [], "window": [-240, -170], "required": true },
    { "id": "pad_clear", "role": "ground", "label": "Confirm pad perimeter clear", "after": [], "window": [-240, -150], "required": true },
    { "id": "tank_pressurise", "role": "propulsion", "label": "Pressurise propellant tank", "after": ["arm_retract"], "window": [-230, -120], "required": true,
      "effects": [{ "value": "tank_pressure", "set": 250 }] },
    { "id": "feed_prime", "role": "propulsion", "label": "Prime engine feed lines", "after": ["pad_clear"], "window": [-220, -110], "required": true },
    { "id": "deluge_arm", "role": "ground", "label": "Arm flame-trench coolant deluge", "after": ["pad_clear"], "window": [-210, -100], "required": true },
    { "id": "bus_transfer", "role": "ground", "label": "Transfer to internal power bus", "after": ["arm_retract"], "window": [-200, -100], "required": true,
      "effects": [{ "value": "bus_voltage", "set": 28 }] },
    { "id": "engine_chill", "role": "propulsion", "label": "Chill engine to start temperature", "after": ["tank_pressurise", "feed_prime"], "window": [-150, -70], "required": true },
    { "id": "range_confirm", "role": "ground", "label": "Confirm range tracking handoff", "after": ["deluge_arm"], "window": [-110, -50], "required": true },
    { "id": "igniter_arm", "role": "propulsion", "label": "Arm igniter circuit", "after": ["poll_1", "engine_chill"], "window": [-90, -30], "required": true },
    { "id": "launch_authority", "role": "flight", "label": "Give launch authority", "after": ["poll_2"], "window": [-25, -4], "required": true },
    { "id": "fix_vent", "role": "propulsion", "label": "Cycle tank vent valve", "after": [], "required": false,
      "effects": [{ "value": "tank_pressure", "set": 250, "driftPerSec": 0 }] },
    { "id": "fix_bus", "role": "ground", "label": "Switch to backup power bus", "after": [], "required": false,
      "effects": [{ "value": "bus_voltage", "set": 28, "driftPerSec": 0 }] }
  ],
  "polls": [
    { "id": "poll_1", "label": "Go/no-go: propellant and pad readiness", "after": ["tank_pressurise", "feed_prime", "deluge_arm", "bus_transfer"], "window": [-110, -60] },
    { "id": "poll_2", "label": "Go/no-go: final launch readiness", "after": ["igniter_arm", "range_confirm"], "window": [-40, -10] }
  ],
  "faults": [
    {
      "id": "vent_stuck",
      "role": "propulsion",
      "label": "Tank vent valve position unconfirmed",
      "window": [-170, -110],
      "chance": 0.8,
      "realChance": 0.6,
      "severity": "explode",
      "effect": { "value": "tank_pressure", "driftPerSec": 0.9 },
      "crossCheck": { "role": "ground", "label": "Vent line temperature" },
      "fixStep": "fix_vent"
    },
    {
      "id": "bus_sag",
      "role": "ground",
      "label": "Pad bus B voltage sag",
      "window": [-150, -100],
      "chance": 0.5,
      "realChance": 0.5,
      "severity": "abort",
      "effect": { "value": "bus_voltage", "driftPerSec": -0.02 },
      "crossCheck": { "role": "propulsion", "label": "Umbilical bus ammeter" },
      "fixStep": "fix_bus"
    }
  ]
}
