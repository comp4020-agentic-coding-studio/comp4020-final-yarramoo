{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "build:sim": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --manifest-path sim/Cargo.toml --target wasm32-unknown-unknown --release",
    "build:sim:canary": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --manifest-path sim/Cargo.toml --target wasm32-unknown-unknown --release --features canary --target-dir sim/target-canary",
    "dev:client": "pnpm build:sim && vite --config client/vite.config.ts",
    "build:client": "pnpm build:sim && vite build --config client/vite.config.ts",
    "test:determinism": "pnpm build:sim && pnpm build:sim:canary && vitest run --config vitest.determinism.config.ts",
    "test:net": "vitest run --config vitest.net.config.ts",
    "start:game": "node server/main.ts",
    "dev:server": "pnpm build:client && node server/main.ts",
    "build:client:only": "vite build --config client/vite.config.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.0",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "ws": "^8.22.0"
  }
}
